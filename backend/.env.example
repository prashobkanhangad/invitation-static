PORT=5000
NODE_ENV=development

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/invitation_temp

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Where the backend should generate URLs for uploaded files
ASSET_BASE_URL=http://localhost:5000

# Cloud storage (set active provider via /api/admin/settings)
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=
#
# GCP_STORAGE_BUCKET=
# Option A: pass service account JSON directly (single-line JSON string)
# GCP_CREDENTIALS_JSON=
# Option B: path to service account file
# GCP_KEY_FILENAME=

